// Signing configuration
// Can be overridden by Local.xcconfig (copy from Local.xcconfig.example)
// or by environment variables in CI/CD

// For local development, copy Local.xcconfig.example to Local.xcconfig
// and set your credentials there (it's gitignored)
#include? "Local.xcconfig"

// In CI/CD, these are set via environment variables in GitHub Actions
// The certificate is imported into keychain, and Xcode automatically finds it
// CODE_SIGN_IDENTITY will be set from APPLE_DEVELOPER_ID secret
// DEVELOPMENT_TEAM will be set from APPLE_TEAM_ID secret

// Note: If Local.xcconfig exists, it will override these settings for local development


// Managed strict mode requires separately issued host and system-extension
// profiles with Network Extensions and the shared Keychain access group.
// Set both in Local.xcconfig or with xcodebuild build-setting arguments:
// FCX_HOST_PROVISIONING_PROFILE = host-profile-name
// FCX_STRICT_PROVISIONING_PROFILE = provider-profile-name
// Both targets must use the same DEVELOPMENT_TEAM and signing identity.
